{
  "expo": {
    "name": "Sonora",
    "slug": "sonora-nas-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sonora-app-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sonora.nasplayer"
    },
    "android": {
      "package": "com.sonora.nasplayer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/sonora-app-icon.png",
        "backgroundColor": "#F30B12"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/apple_music_icon.png",
          "imageWidth": 116,
          "resizeMode": "contain",
          "backgroundColor": "#08080B",
          "dark": {
            "image": "./assets/apple_music_icon.png",
            "backgroundColor": "#08080B"
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bef37155-33ef-469c-ac1e-06114ec63f00"
      }
    }
  }
}
