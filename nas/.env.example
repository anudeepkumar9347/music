# Shared API access token. Use the same value in mobile app .env files.
API_TOKEN=replace-with-a-long-random-token

# Paste the API key sent by OMDb here, not the /apikey page URL.
OMDB_API_KEY=

# Optional music fingerprint matching key from https://acoustid.org/new-application
ACOUSTID_APP_KEY=

# Country used by the no-key iTunes movie metadata fallback.
ITUNES_COUNTRY=IN

# Contact URL/address for MusicBrainz requests.
METADATA_USER_AGENT=OrbitNAS/0.1 (you@example.com)
